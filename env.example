# Copy to "High Fi DLSU Chorale Website/.env.local" (never commit that file).
# This is a Vite app — env vars must be prefixed VITE_ to reach the browser.

VITE_SUPABASE_URL=your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where admin-facing notifications (new excuse filed, new incident report,
# etc.) get sent — a placeholder until per-role notification emails exist.
VITE_ADMIN_EMAIL=someone@example.com

# Optional — only needed for the account-setup/HR-OTP allowlist bypass in
# Login.tsx; comma-separated school IDs.
VITE_ADMIN_SCHOOL_IDS=

# Server-side only — set as Supabase Edge Function secrets (Dashboard →
# Edge Functions → secrets), never in this file or the frontend build:
#   RESEND_API_KEY            — used by supabase/functions/send-email
#   SUPABASE_SERVICE_ROLE_KEY — provided automatically to every Edge Function
